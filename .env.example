# ============================================
# RegistroJornada — Variables de entorno
# Copiar a .env y ajustar.
# ============================================

APP_NAME=Generador de Registros de Jornada

# Para servir solo localmente:        APP_HOST=127.0.0.1
# Para servir a toda la red local:    APP_HOST=0.0.0.0
APP_HOST=0.0.0.0
APP_PORT=8600
APP_ENV=development

# Ruta del fichero SQLite (relativa a la raiz del proyecto).
# En modo WAL se generan dos ficheros adicionales junto al .db:
#   registro.db-wal  y  registro.db-shm  (incluirlos en los backups).
DATABASE_URL=sqlite:///./data/registro.db

# Clave para firmar la cookie de sesión. Generarla con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotarla invalida todas las sesiones activas.
SECRET_KEY=cambia_esto_por_un_token_aleatorio_de_64_hex

# DNI del administrador inicial. Al arrancar la app:
#   - Si el usuario no existe, se crea como admin.
#   - Si existe como usuario normal, se promueve a admin.
#   - Si ya es admin, no se hace nada (idempotente).
# Dejar vacío para omitir el bootstrap.
ADMIN_DNI=00000000A
